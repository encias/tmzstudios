{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmzstudios-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*.mp4"]
  },
  "routes": [
    { "pattern": "tmzstudios.com", "custom_domain": true },
    { "pattern": "www.tmzstudios.com", "custom_domain": true }
  ]
}
